<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Legacy empty-state .webp (old JS bundle) → SVG in assets/illustrations -->
        <rule name="Legacy reservation-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/reservation-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-reservation.svg" />
        </rule>
        <rule name="Legacy top-selling-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/top-selling-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-popular-items.svg" />
        </rule>
        <rule name="Legacy pos-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/pos-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-popular-items.svg" />
        </rule>
        <rule name="Legacy orders-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/orders-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-invoice.svg" />
        </rule>
        <rule name="Legacy customers-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/customers-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-customers.svg" />
        </rule>
        <rule name="Legacy kitchen-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/kitchen-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/kitchen.svg" />
        </rule>
        <rule name="Legacy kitchen-order-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/kitchen-order-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/kitchen.svg" />
        </rule>
        <rule name="Legacy invoice-not-found webp" stopProcessing="true">
          <match url="^assets/illustrations/invoice-not-found\.webp$" ignoreCase="true" />
          <action type="Rewrite" url="assets/illustrations/no-invoice.svg" />
        </rule>
        <!-- Old builds request manifest.webmanifest; serve manifest.json if present -->
        <rule name="PWA manifest alias" stopProcessing="true">
          <match url="^manifest\.webmanifest$" ignoreCase="true" />
          <action type="Rewrite" url="manifest.json" />
        </rule>
        <!-- SPA fallback: do not rewrite real files, /assets/*, or PWA root files -->
        <rule name="React Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(manifest\.json|manifest\.webmanifest|registerSW\.js|sw\.js|workbox-[^/]+\.js|logo(_192)?\.png|theme-favicon-logo\.png)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
